// Receives Faro telemetry from the browser and writes it to Loki as `key=value` lines.
// Replay payloads, markers and ordinary Faro events each get their own stream labels.
faro.receiver "default" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    cors_allowed_origins     = ["http://127.0.0.1:5173", "http://localhost:5173"]
    api_key                  = sys.env("FARO_API_KEY")
    max_allowed_payload_size = "16MiB"
    rate_limiting {
      enabled    = true
      rate       = 100
      burst_size = 200
    }
  }
  output {
    logs = [loki.process.faro.receiver]
  }
}

loki.process "faro" {
  forward_to = [loki.write.default.receiver]

  stage.logfmt {
    mapping = { app_name = "", app_environment = "" }
  }
  stage.structured_metadata {
    values = { app_name = "", app_environment = "" }
  }
  stage.static_labels {
    values = { source = "faro" }
  }
  stage.match {
    selector = "{source=\"faro\"} |= \"event_name=faro.session_recording.event \""
    stage.static_labels {
      values = { source = "faro_replay", replay = "payload" }
    }
  }
  stage.match {
    selector = "{source=\"faro\"} |= \"event_name=faro.session_recording.\""
    stage.static_labels {
      values = { source = "faro_replay", replay = "marker" }
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
