{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Session Replay",
  "id": "escalia-sessionreplay-app",
  "info": {
    "keywords": ["faro", "session replay", "rrweb", "loki", "frontend observability"],
    "description": "Browse and replay browser sessions recorded by Grafana Faro and stored in Loki, in JSON or logfmt.",
    "author": {
      "name": "KloutDevs"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Sessions list",
        "path": "img/screenshots/sessions.png"
      },
      {
        "name": "Replay with timeline and journey",
        "path": "img/screenshots/replay.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "Source",
        "url": "https://github.com/KloutDevs/grafana-session-replay-app"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/KloutDevs/grafana-session-replay-app/issues"
      },
      {
        "name": "License",
        "url": "https://github.com/KloutDevs/grafana-session-replay-app/blob/main/LICENSE"
      }
    ]
  },
  "includes": [
    {
      "type": "page",
      "name": "Sessions",
      "path": "/a/%PLUGIN_ID%/sessions",
      "role": "Editor",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
